# Ollama Local AI (default: localhost)
# OLLAMA_URL=http://localhost:11434

# ==================== Email (Optional) ====================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ==================== Client ====================
# VITE_API_URL=http://localhost:5000/api
