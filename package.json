{
  "name": "ipms-enarxi-workspace",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "node scripts/dev-root.mjs",
    "dev:workspace": "pnpm --parallel --filter server --filter client run dev",
    "dev:bom": "node scripts/dev-root.mjs --bom-only",
    "dev:client": "pnpm --filter client run dev",
    "dev:server": "pnpm --filter server run dev",
    "build": "pnpm --filter client run build"
  }
}
